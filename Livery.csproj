<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Livery</RootNamespace>
    <AssemblyName>Livery</AssemblyName>
    <LangVersion>preview</LangVersion>
    <Description>Standalone appearance layer: localization and the JSON theme engine.</Description>
    <!-- NuGet packaging (GitHub Packages feed; a later nuget.org move only
         changes the push target - the consumer PackageReference stays). -->
    <PackageId>Livery</PackageId>
    <Version>0.1.10</Version>
    <Authors>ZettaTrade Contributors</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/ZettaTrade/Livery.git</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- A root-level csproj globs everything below it; the tests tree is
         the test project's own compile scope (its ProjectReference builds
         this library), so keep it out of the library's compile glob. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);tests/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- The library styles (window chrome templates + title bar + the
         control restyling) ship as a compiled Avalonia resource; the host
         includes them via <StyleInclude Source="avares://Livery/Themes/Controls.axaml" />. -->
    <AvaloniaResource Include="Themes\Controls.axaml" />
    <!-- The type/spacing/numeric tokens (T-155) ship as a compiled
         Avalonia resource; the host merges them via
         <ResourceInclude Source="avares://Livery/Themes/Tokens.axaml" />. -->
    <AvaloniaResource Include="Themes\Tokens.axaml" />
    <InternalsVisibleTo Include="ZettaTrade.UI.Tests" />
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
    <PackageReference Include="System.Reactive" Version="7.0.0" />
  </ItemGroup>

</Project>
