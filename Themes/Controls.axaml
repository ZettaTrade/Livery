<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:Livery.Localization"
        xmlns:converters="using:Avalonia.Data.Converters"
        xmlns:livery="using:Livery.Controls">

    <!--
    The window chrome + shell control restyling library styles (T-066).
    Include from the host App.axaml with:
        <StyleInclude Source="avares://Livery/Themes/Controls.axaml" />
    Every color here rides a theme palette key published as a Color resource
    by the theme engine (Background, Surface, Border, Accent, TextPrimary,
    TextSecondary, Error, and the chrome pair TitleBar / TitleBarText) — the
    property system adjusts Color values into brushes directly, so a theme or
    a hot-reloaded file change retints everything live. General control
    styles come first; the chrome-scoped styles after them win where both
    match (Avalonia applies the last matching style).
    -->

    <!-- ============================================================== -->
    <!-- Shell control restyling: the palette colors every stock surface -->
    <!-- ============================================================== -->

    <Style Selector="Button">
        <Setter Property="Background" Value="{DynamicResource Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>
    <Style Selector="Button:pointerover">
        <Setter Property="Background" Value="{DynamicResource Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>
    <Style Selector="Button:pressed">
        <Setter Property="Background" Value="{DynamicResource Border}" />
    </Style>

    <!-- Keyboard focus indicators (T-110): every focusable control shows a
         visible marker the moment keyboard focus lands on it — the button
         family borrows the palette's on-state accent for its border, the
         tab/menu family tints the text with it. TextBox/ComboBox already
         retint their borders on focus. -->
    <Style Selector="Button:focus">
        <Setter Property="BorderBrush" Value="{DynamicResource Highlight}" />
    </Style>
    <Style Selector="ToggleButton:focus">
        <Setter Property="BorderBrush" Value="{DynamicResource Highlight}" />
    </Style>

    <Style Selector="TextBox">
        <Setter Property="Background" Value="{DynamicResource Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>
    <Style Selector="TextBox:focus">
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    </Style>

    <Style Selector="ComboBox">
        <Setter Property="Background" Value="{DynamicResource Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>
    <Style Selector="ComboBox:focus">
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    </Style>

    <Style Selector="TabItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    </Style>
    <Style Selector="TabItem:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>
    <Style Selector="TabItem:selected">
        <Setter Property="Background" Value="{DynamicResource Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>
    <Style Selector="TabItem:focus">
        <Setter Property="Foreground" Value="{DynamicResource Highlight}" />
    </Style>

    <Style Selector="Menu">
        <Setter Property="Background" Value="{DynamicResource Surface}" />
    </Style>
    <Style Selector="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>
    <Style Selector="MenuItem:pointerover">
        <Setter Property="Background" Value="{DynamicResource Accent}" />
    </Style>
    <Style Selector="MenuItem:focus">
        <Setter Property="Foreground" Value="{DynamicResource Highlight}" />
    </Style>

    <!-- ============================================================ -->
    <!-- Window chrome: extended client area + our own title-bar strip -->
    <!-- ============================================================ -->
    <!-- Windows that opt in via Classes="chrome" (or the compact variant for
         fixed-size dialogs) drop the caption down to the drawn strip. Avalonia
         12 mechanism: the client area extends across the whole window rect and
         WindowDecorations rides BorderOnly — the window keeps the native
         resize side, the snap layouts and the DWM shadow (WS_THICKFRAME stays
         on for resizable windows) while the system caption (WS_CAPTION /
         WS_SYSMENU) is absent and no managed decoration overlay is requested
         (the platform only asks for a drawn TitleBar with Full decorations).
         The Alt+F4 OS close gesture rides the system menu, so the title bar
         control restores it: see TitleBar's keyboard hook.
         The presenter must mirror the native window template's Content
         bindings (Content, ContentTemplate and the padding/alignment set):
         Avalonia 12 presents ContentControl.Content only through those
         explicit template bindings — a bare PART_ContentPresenter stays
         empty and the window renders as the bare background. -->
    <Style Selector="Window.chrome">
        <Setter Property="ExtendClientAreaToDecorationsHint" Value="True" />
        <Setter Property="WindowDecorations" Value="BorderOnly" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid RowDefinitions="Auto,*" Background="{TemplateBinding Background}">
                    <livery:TitleBar Grid.Row="0"
                                     Logo="{Binding Path=(livery:WindowChrome.Logo), RelativeSource={RelativeSource TemplatedParent}}" />
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Grid.Row="1"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Content="{TemplateBinding Content}"
                                      Margin="{TemplateBinding Padding}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="Window.chrome-compact">
        <Setter Property="ExtendClientAreaToDecorationsHint" Value="True" />
        <Setter Property="WindowDecorations" Value="BorderOnly" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid RowDefinitions="Auto,*" Background="{TemplateBinding Background}">
                    <livery:TitleBar Grid.Row="0"
                                     ShowMinimizeButton="False" ShowMaximizeButton="False"
                                     Logo="{Binding Path=(livery:WindowChrome.Logo), RelativeSource={RelativeSource TemplatedParent}}" />
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Grid.Row="1"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Content="{TemplateBinding Content}"
                                      Margin="{TemplateBinding Padding}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- ==================== -->
    <!-- The title-bar itself -->
    <!-- ==================== -->
    <Style Selector="livery|TitleBar">
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_Root"
                        Height="32"
                        Background="{DynamicResource TitleBar}">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">

                        <!-- The optional logo slot (the host window's
                             livery:WindowChrome.Logo): any control the app
                             passes, presented hit-invisible at the strip's
                             left edge — presses land on the shared drag
                             surface, the strip's contract survives the mark.
                             Null hides the slot entirely. -->
                        <ContentPresenter Name="PART_Logo"
                                          Grid.Column="0"
                                          Width="16" Height="16"
                                          Margin="10,0,0,0"
                                          VerticalAlignment="Center"
                                          IsHitTestVisible="False"
                                          IsVisible="{Binding Logo, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static converters:ObjectConverters.IsNotNull}}"
                                          Content="{TemplateBinding Logo}" />

                        <!-- The title mirrors the host window's Title (the
                             control watches it), entirely hit-invisible so
                             presses land on the shared drag surface. -->
                        <TextBlock Name="PART_Title"
                                   Grid.Column="1"
                                   Margin="10,0"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   Foreground="{DynamicResource TitleBarText}"
                                   TextTrimming="CharacterEllipsis"
                                   IsHitTestVisible="False" />

                        <!-- Decorative buttons: borderless and background-free
                             (the strip styles below), the icons carry their
                             stroke inline; the close icon rides the styles so
                             the hover can retint it. -->
                        <Button Name="PART_MinimizeButton"
                                Grid.Column="2"
                                Classes="strip-icon"
                                Width="44" Height="32"
                                AutomationProperties.Name="{loc:Localized Chrome.Minimize}"
                                ToolTip.Tip="{loc:Localized Chrome.Minimize}">
                            <Path Data="M 0 5.5 H 10"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Stroke="{DynamicResource TitleBarText}"
                                  StrokeThickness="1.5" />
                        </Button>

                        <Button Name="PART_MaximizeButton"
                                Grid.Column="3"
                                Classes="strip-icon"
                                Width="44" Height="32"
                                AutomationProperties.Name="{loc:Localized Chrome.Maximize}"
                                ToolTip.Tip="{loc:Localized Chrome.Maximize}">
                            <Path Data="M 0.75 6.25 V 0.75 H 9.75 V 9.75 H 0.75 Z"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Stroke="{DynamicResource TitleBarText}"
                                  StrokeThickness="1.5" />
                        </Button>

                        <!-- Restores the maximized window instead; one icon
                             per slot keeps each tooltip honest. -->
                        <Button Name="PART_RestoreButton"
                                Grid.Column="3"
                                Classes="strip-icon"
                                Width="44" Height="32"
                                IsVisible="False"
                                AutomationProperties.Name="{loc:Localized Chrome.Restore}"
                                ToolTip.Tip="{loc:Localized Chrome.Restore}">
                            <Path Data="M 3 5.4 H 10.2 V 12.6 H 3 Z M 5.4 5.4 V 3 H 12.6 V 10.2 H 10.2"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Stroke="{DynamicResource TitleBarText}"
                                  StrokeThickness="1.5" />
                        </Button>

                        <Button Name="PART_CloseButton"
                                Grid.Column="4"
                                Classes="strip-icon strip-close"
                                Width="44" Height="32"
                                AutomationProperties.Name="{loc:Localized Chrome.Close}"
                                ToolTip.Tip="{loc:Localized Chrome.Close}">
                            <Path Data="M 0 0 L 10 10 M 10 0 L 0 10"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        </Button>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- The strip icon buttons: the caption highlight rides the icon itself
         per the Windows 11 convention — no bigger-than-icon rectangle. The
         Fluent button paints its state fill on the template's content
         presenter (not through the button background), so the presenter is
         the override target for the fill/border suppression; the rest of
         the feedback is the icon's own brightness (button opacity: slightly
         translucent at rest, fully opaque on hover, a touch dimmer pressed).
         The close icon additionally takes the palette danger color: content
         descendants are reachable at the application level over the logical
         tree, while template internals of other controls are not. -->
    <Style Selector="livery|TitleBar Button.strip-icon">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Opacity" Value="0.85" />
    </Style>
    <Style Selector="livery|TitleBar Button.strip-icon /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="livery|TitleBar Button.strip-icon:pointerover">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="livery|TitleBar Button.strip-icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="livery|TitleBar Button.strip-icon:pressed">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Opacity" Value="0.8" />
    </Style>
    <Style Selector="livery|TitleBar Button.strip-icon:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="livery|TitleBar Button.strip-icon:focus">
        <Setter Property="Opacity" Value="1" />
    </Style>

    <!-- The close icon carries its stroke through the styles (not a template
         value) so the hover can retint it live: the palette danger color on
         hover, the palette text color otherwise. -->
    <Style Selector="livery|TitleBar Button.strip-close Path">
        <Setter Property="Stroke" Value="{DynamicResource TitleBarText}" />
        <Setter Property="StrokeThickness" Value="1.5" />
    </Style>
    <Style Selector="livery|TitleBar Button.strip-close:pointerover Path">
        <Setter Property="Stroke" Value="{DynamicResource Error}" />
    </Style>

    <!-- ============================================================== -->
    <!-- The shared chrome kit (T-154): Chip, StateDot, the toggle .on   -->
    <!-- class, IconButton, InfoIcon — the vocabulary the views once     -->
    <!-- re-typed by hand. Every fill/text key is a palette key, so the  -->
    <!-- kit retints live with the themes.                               -->
    <!-- ============================================================== -->

    <!-- The chip: the rounded state badge (the trading-lane pill and the
         testnet badges). The shape, the per-state fills and the caption
         treatment live here; the readable foreground (T-152) rides the
         host's derived ChipForeground brush — a host without the
         derivation keeps its ambient foreground honestly. -->
    <Style Selector="Border.chip">
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Padding" Value="8,2" />
    </Style>
    <Style Selector="Border.chip > TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource ChipForeground}" />
    </Style>
    <Style Selector="Border.chip.paper">
        <Setter Property="Background" Value="{DynamicResource CandleUp}" />
    </Style>
    <Style Selector="Border.chip.testnet">
        <Setter Property="Background" Value="{DynamicResource Highlight}" />
    </Style>
    <Style Selector="Border.chip.live">
        <Setter Property="Background" Value="{DynamicResource Error}" />
    </Style>

    <!-- The state dot: the small ellipse whose fill the state class picks
         from the same palette keys the chips speak (the health strip's
         T-098 vocabulary). The size stays the consumer's; the `dot` base
         class namespaces the states so the kit never grabs a foreign
         ellipse. -->
    <Style Selector="Ellipse.dot.connected">
        <Setter Property="Fill" Value="{DynamicResource CandleUp}" />
    </Style>
    <Style Selector="Ellipse.dot.reconnecting">
        <Setter Property="Fill" Value="{DynamicResource Highlight}" />
    </Style>
    <Style Selector="Ellipse.dot.down">
        <Setter Property="Fill" Value="{DynamicResource Error}" />
    </Style>
    <Style Selector="Ellipse.dot.unsupervised">
        <Setter Property="Fill" Value="{DynamicResource TextSecondary}" />
    </Style>

    <!-- The toggle .on class (the chart toolbar's five copies moved here
         verbatim): the armed toggle reads full-bright over the Highlight
         stroke and text; the rest-state dimming stays the consumer's. -->
    <Style Selector="Button.on, ToggleButton.on">
        <Setter Property="Opacity" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource Highlight}" />
        <Setter Property="Foreground" Value="{DynamicResource Highlight}" />
    </Style>

    <!-- The icon button: the strip-icon-like action — borderless and
         background-free with the title-bar strip's opacity feedback. The
         Fluent button paints its state fill on the template's content
         presenter, so the presenter is the suppression target (the same
         mechanism the title-bar strip-icon styles carry). -->
    <Style Selector="Button.icon">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Opacity" Value="0.85" />
    </Style>
    <Style Selector="Button.icon /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.icon:pointerover">
        <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.icon:pressed">
        <Setter Property="Opacity" Value="0.8" />
    </Style>
    <Style Selector="Button.icon:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.icon:focus">
        <Setter Property="Opacity" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource Highlight}" />
    </Style>
    <Style Selector="Button.icon:focus /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- The armed icon (the .on class composed over .icon): the armed
         state reads full-bright and the glyph strokes in the armed ink —
         the descendant rule reaches the Path content the Foreground
         setter cannot (the strip's own glyphs carry explicit strokes),
         and the rule rides after the .icon block so the opacity race
         settles in the armed state's favor. -->
    <Style Selector="Button.icon.on">
        <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.icon.on Path">
        <Setter Property="Stroke" Value="{DynamicResource Highlight}" />
    </Style>

    <!-- The info icon: the circled "i" affordance (the settings surface's
         seven Border+TextBlock copies became this control). Focusable with
         the keyboard-focus ring on the template ring (the T-110 canon:
         every focusable control shows a visible marker); the consumer
         carries the automation name and the tooltip on the control. -->
    <Style Selector="livery|InfoIcon">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_Ring"
                        CornerRadius="8"
                        Background="Transparent"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource Border}">
                    <TextBlock Text="i"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondary}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="livery|InfoIcon:focus /template/ Border#PART_Ring">
        <Setter Property="BorderBrush" Value="{DynamicResource Highlight}" />
    </Style>

    <!-- ============================================================== -->
    <!-- The panel header scaffold (T-160): the heads the panels share — -->
    <!-- the title left, the actions right (a right-docked child), ONE   -->
    <!-- padding grammar riding the spacing scale, and the title         -->
    <!-- treatment published once. A bare caption (no actions) or a      -->
    <!-- tab's header text rides the title treatment alone through the   -->
    <!-- .panel-title class. The tokens read through DynamicResource in  -->
    <!-- the kit styles (a Styles dictionary cannot StaticResource its   -->
    <!-- sibling dictionary) — the consumer merges Tokens.axaml above    -->
    <!-- this include, so the values resolve at the point of use.        -->
    <!-- ============================================================== -->
    <Style Selector="DockPanel.panel-header">
        <Setter Property="Margin" Value="{DynamicResource InsetS}" />
    </Style>
    <Style Selector="DockPanel.panel-header > TextBlock, TextBlock.panel-title">
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="{DynamicResource SubtitleStrongFontSize}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
</Styles>
